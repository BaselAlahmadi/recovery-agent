{
  "meta": {
    "purpose": "Evaluation scenarios. DEV may be used to tune the agent. HELD-OUT must never be used for tuning: it is run once, after the agent is frozen.",
    "repetitions": 3,
    "rep_seed_offset": "traffic seed for repetition r (1..3) = scenario seed + 100*r",
    "timeline": "t=0 traffic starts. Each fault is injected at its at_s. The method (agent/baseline) starts at agent_at_s. After it finishes, traffic and faults stay on for hold_s, then recovery is checked independently.",
    "hold_s": 12,
    "fault_ids": {
      "f1": "payment drop (bad 'assume success' deploy + flaky provider); rate = share of provider calls that time out",
      "f2": "queue loss (bad tiny queue + drop deploy + slow worker); rate = extra seconds per worker step",
      "f3": "sync corruption (bad sync_mode deploy); rate = share of replica rows corrupted per run",
      "f4": "workflow hang; rate = share of orders whose pack step hangs",
      "f5": "UNFIXABLE payment provider outage; rate = share of provider calls that time out"
    },
    "root_cause_of": {"f1": "payment_drop", "f2": "queue_loss", "f3": "sync_corruption", "f4": "stuck_worker", "f5": "external_provider"},
    "outcome_rule": "any f5 -> ESCALATED (all other faults must still be fixed); other faults only -> RESOLVED; no faults -> NO_INCIDENT"
  },
  "dev": [
    {"id": "dev_healthy", "seed": 101, "traffic_rate": 5, "faults": [], "agent_at_s": 20,
     "expected_outcome": "NO_INCIDENT", "expected_root_causes": []},
    {"id": "dev_f1", "seed": 102, "traffic_rate": 5, "faults": [{"id": "f1", "rate": 0.3, "at_s": 6}], "agent_at_s": 24,
     "expected_outcome": "RESOLVED", "expected_root_causes": ["payment_drop"]},
    {"id": "dev_f2", "seed": 103, "traffic_rate": 5, "faults": [{"id": "f2", "rate": 0.1, "at_s": 6}], "agent_at_s": 24,
     "expected_outcome": "RESOLVED", "expected_root_causes": ["queue_loss"]},
    {"id": "dev_f3", "seed": 104, "traffic_rate": 5, "faults": [{"id": "f3", "rate": 0.1, "at_s": 6}], "agent_at_s": 24,
     "expected_outcome": "RESOLVED", "expected_root_causes": ["sync_corruption"]},
    {"id": "dev_f4", "seed": 105, "traffic_rate": 5, "faults": [{"id": "f4", "rate": 0.1, "at_s": 6}], "agent_at_s": 28,
     "expected_outcome": "RESOLVED", "expected_root_causes": ["stuck_worker"]},
    {"id": "dev_f1_f4", "seed": 106, "traffic_rate": 5,
     "faults": [{"id": "f1", "rate": 0.3, "at_s": 6}, {"id": "f4", "rate": 0.1, "at_s": 6}], "agent_at_s": 28,
     "expected_outcome": "RESOLVED", "expected_root_causes": ["payment_drop", "stuck_worker"]},
    {"id": "dev_f2_f3", "seed": 107, "traffic_rate": 5,
     "faults": [{"id": "f2", "rate": 0.1, "at_s": 6}, {"id": "f3", "rate": 0.1, "at_s": 6}], "agent_at_s": 26,
     "expected_outcome": "RESOLVED", "expected_root_causes": ["queue_loss", "sync_corruption"]},
    {"id": "dev_f5", "seed": 108, "traffic_rate": 5, "faults": [{"id": "f5", "rate": 1.0, "at_s": 6}], "agent_at_s": 34,
     "expected_outcome": "ESCALATED", "expected_root_causes": ["external_provider"]}
  ],
  "heldout": [
    {"id": "ho_f1_f2", "seed": 201, "traffic_rate": 6,
     "faults": [{"id": "f1", "rate": 0.5, "at_s": 8}, {"id": "f2", "rate": 0.15, "at_s": 10}], "agent_at_s": 30,
     "expected_outcome": "RESOLVED", "expected_root_causes": ["payment_drop", "queue_loss"]},
    {"id": "ho_f3_f4", "seed": 202, "traffic_rate": 5,
     "faults": [{"id": "f3", "rate": 0.2, "at_s": 7}, {"id": "f4", "rate": 0.15, "at_s": 12}], "agent_at_s": 32,
     "expected_outcome": "RESOLVED", "expected_root_causes": ["sync_corruption", "stuck_worker"]},
    {"id": "ho_f1_f2_f4", "seed": 203, "traffic_rate": 5,
     "faults": [{"id": "f1", "rate": 0.4, "at_s": 6}, {"id": "f2", "rate": 0.12, "at_s": 9}, {"id": "f4", "rate": 0.1, "at_s": 14}],
     "agent_at_s": 34,
     "expected_outcome": "RESOLVED", "expected_root_causes": ["payment_drop", "queue_loss", "stuck_worker"]},
    {"id": "ho_f1_f3", "seed": 204, "traffic_rate": 5,
     "faults": [{"id": "f1", "rate": 0.3, "at_s": 8}, {"id": "f3", "rate": 0.15, "at_s": 8}], "agent_at_s": 28,
     "expected_outcome": "RESOLVED", "expected_root_causes": ["payment_drop", "sync_corruption"]},
    {"id": "ho_f4_f5", "seed": 205, "traffic_rate": 5,
     "faults": [{"id": "f4", "rate": 0.1, "at_s": 6}, {"id": "f5", "rate": 1.0, "at_s": 10}], "agent_at_s": 38,
     "expected_outcome": "ESCALATED", "expected_root_causes": ["stuck_worker", "external_provider"]},
    {"id": "ho_healthy_low", "seed": 206, "traffic_rate": 1, "faults": [], "agent_at_s": 20,
     "expected_outcome": "NO_INCIDENT", "expected_root_causes": []},
    {"id": "ho_healthy_high", "seed": 207, "traffic_rate": 12, "faults": [], "agent_at_s": 20,
     "expected_outcome": "NO_INCIDENT", "expected_root_causes": []},
    {"id": "ho_f1_heavy", "seed": 208, "traffic_rate": 8, "faults": [{"id": "f1", "rate": 0.5, "at_s": 10}], "agent_at_s": 30,
     "expected_outcome": "RESOLVED", "expected_root_causes": ["payment_drop"]},
    {"id": "ho_f2_heavy", "seed": 209, "traffic_rate": 7, "faults": [{"id": "f2", "rate": 0.2, "at_s": 8}], "agent_at_s": 28,
     "expected_outcome": "RESOLVED", "expected_root_causes": ["queue_loss"]},
    {"id": "ho_f3_strong", "seed": 210, "traffic_rate": 5, "faults": [{"id": "f3", "rate": 0.3, "at_s": 12}], "agent_at_s": 32,
     "expected_outcome": "RESOLVED", "expected_root_causes": ["sync_corruption"]},
    {"id": "ho_f4_late", "seed": 211, "traffic_rate": 4, "faults": [{"id": "f4", "rate": 0.08, "at_s": 15}], "agent_at_s": 42,
     "expected_outcome": "RESOLVED", "expected_root_causes": ["stuck_worker"]},
    {"id": "ho_f5_partial", "seed": 212, "traffic_rate": 5, "faults": [{"id": "f5", "rate": 0.8, "at_s": 8}], "agent_at_s": 38,
     "expected_outcome": "ESCALATED", "expected_root_causes": ["external_provider"]}
  ]
}
